# Backend config — copy to .env and fill in your own project values.
# The search API works without these (notes travel in the request body);
# they are for the Supabase-backed version of the API (see backend/README.md).
# Never commit a filled-in .env — only this example file belongs in git.

# Supabase project (https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key is only for server-side admin work. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port the API listens on locally
PORT=8000

# Comma-separated origins allowed to call the API (frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,https://husnainnnn.github.io
